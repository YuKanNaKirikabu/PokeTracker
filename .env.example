# Public ports on the server. Both ports serve the same PokeTracker application.
POKETRACKER_PORT=1025
POKETRACKER_SECOND_PORT=1111

MONGODB_DATABASE=poketracker
MONGODB_URI=mongodb://mongodb:27017

POKETRACKER_DATA_BASE_URL=https://storage.yandexcloud.net/poketracker/data
POKETRACKER_REMOTE_WRITE=1
POKETRACKER_SAFE_MODE=0
